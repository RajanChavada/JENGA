# JENGA backend environment. Copy to /etc/jenga.env on the server, fill in the
# values, then: chmod 600 /etc/jenga.env && systemctl restart jenga-backend.
#
# EVERY key is optional. Each one flips a mock to live; missing/failed keys
# degrade gracefully so the demo never dies. Never commit the filled-in file.

# --- core (no secrets) -------------------------------------------------------
JENGA_STORAGE=memory
JENGA_OFFLINE=0
JENGA_SENSORS=1

# --- AI pipeline -------------------------------------------------------------
# Vision + real document extraction (the biggest quality jump).
OPENAI_API_KEY=${OPENAI_API_KEY}
# Live authorship gate; heuristic scorer without it.
GPTZERO_API_KEY=${GPTZERO_API_KEY}

# --- Zip procurement (HTN staging) ------------------------------------------
# From {your-domain}/manage/api-key. Base already defaults to staging.
ZIP_API_KEY=${ZIP_API_KEY}
# ZIP_API_URL=https://staging-api.zip.com

# --- Browserbase macro scrape ------------------------------------------------
# Turns the "Scrape live feeds" button green.
BROWSERBASE_API_KEY=${BROWSERBASE_API_KEY}
BROWSERBASE_PROJECT_ID=${BROWSERBASE_PROJECT_ID}

# --- Tiger Data telemetry (optional; simulator + mock store work without) ----
# TIGER_DATABASE_URL=${TIGER_DATABASE_URL}
