# systemd unit for the JENGA backend. Installed by setup-backend.sh to
# /etc/systemd/system/jenga-backend.service. Survives SSH drops and reboots,
# which tmux does not do for you at 3am.
[Unit]
Description=JENGA FastAPI backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/jenga/backend
EnvironmentFile=/etc/jenga.env
ExecStart=/opt/jenga/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
