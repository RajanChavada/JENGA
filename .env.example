# DB_DRIVER selects the data layer in lib/db.ts: 'postgres' (default, local dev
# stand-in until Snowflake access exists) or 'snowflake' (the real thing).
DB_DRIVER=postgres

# Used when DB_DRIVER=postgres. Matches docker-compose.yml's postgres service —
# `docker compose up -d`, then `psql "$DATABASE_URL" -f sql/schema.postgres.sql`.
DATABASE_URL=postgres://jenga:jenga@localhost:5432/jenga

# Used when DB_DRIVER=snowflake — the eventual single system of record for
# tickets, dependencies, branches, reports (see docs/plan.md).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=JENGA_WH
SNOWFLAKE_DATABASE=JENGA
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=

# GPTZero — non-blocking authenticity flag on progress reports
GPTZERO_API_KEY=
